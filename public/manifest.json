{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "CS2 Overlay",
    "version": "2.0.3",
    "minimum-overwolf-version": "0.170.0",
    "author": "Pavel Komarov",
    "icon": "icons/mouseOver.png",
    "icon_gray": "icons/grey.png",
    "description": "Overwolf CS2 Overlay"
  },
  "permissions": [
    "Extensions",
    "Streaming",
    "Profile",
    "GameInfo",
    "Hotkeys"
  ],
  "data": {
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [
        22730
      ]
    },
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [
            22730
          ]
        },
        "start_minimized": false
      }
    ],
    "game_events": [
      22730
    ],
    "start_window": "background",
    "windows": {
      "background": {
        "file": "index.html",
        "background_optimization": true,
        "is_background_page": true
      },
      "in_game": {
        "file": "index.html",
        "in_game_only": true,
        "block_top_window_navigation": true,
        "focus_game_takeover": "ReleaseOnHidden",
        "tansparent":true,
        "size": {
          "width": 350,
          "height": 250
        },
        "start_position": {
          "top": 700,
          "left": 0
        }
      }
    },
    "developer": {
      "enable_auto_refresh": true,
      "reload_delay": 1000,
      "filter": "*.*"
    }
  }
}